MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_TLS_CA_CERT=./certs/ca.crt
MQTT_TLS_CLIENT_CERT=./certs/test-client.crt
MQTT_TLS_CLIENT_KEY=./certs/test-client.key
PROVISIONING_MASTER_KEY=changeme-provisioning-local-dev
JWT_SECRET=smarthouse-jwt-local-dev-secret
JWT_PREVIOUS_SECRET=smarthouse-jwt-previous-local-dev-secret
JWT_ISSUER=smarthouse-device-registry
JWT_AUDIENCE=smarthouse-services
JWT_ALGORITHM=HS256
JWT_ACTIVE_KID=k1
JWT_PREVIOUS_KID=k0
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=30
EDGE_API_KEY=changeme-edge-local-dev
EDGE_API_KEY_ADMIN=changeme-edge-local-dev
EDGE_API_KEY_OPERATOR=changeme-edge-operator-local-dev
EDGE_HTTP_TIMEOUT_SECONDS=5
RECONCILE_SLO_WINDOW_MINUTES=60
RECONCILE_SLO_MAX_DRIFT_RATIO=0.10
RECONCILE_SLO_MIN_EVENTS=5
